# Copy this file to .env and fill in the values. Never commit .env.

# From Google AI Studio (aistudio.google.com) -> Get API key
GEMINI_API_KEY=

# Token for the /admin/keys endpoint. At least 32 characters; generate one in PowerShell with:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
ADMIN_TOKEN=

# Local Postgres (matches docker-compose.yml defaults)
POSTGRES_DB=mnemo
POSTGRES_USER=mnemo
POSTGRES_PASSWORD=mnemo

# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
